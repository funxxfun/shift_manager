<div class="min-h-screen bg-gray-100 p-4">
  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">
        承認待ち一覧
        <% if @support_requests.any? %>
          <span class="ml-2 bg-red-500 text-white text-sm px-2 py-1 rounded-full">
            <%= @support_requests.size %>件
          </span>
        <% end %>
      </h1>
      <p class="text-gray-600 mt-1">
        他店舗からの応援要請を確認・承認できます
      </p>
    </div>

    <% if @support_requests.empty? %>
      <div class="bg-white rounded-lg shadow p-8 text-center">
        <p class="text-gray-500 text-lg">承認待ちの応援要請はありません</p>
        <%= link_to 'AI提案を確認', suggestions_shifts_path, class: 'mt-4 inline-block text-blue-600 hover:underline' %>
      </div>
    <% else %>
      <div class="space-y-4">
        <% @support_requests.each do |request| %>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-lg font-bold text-gray-800">
                    <%= request.date.strftime('%Y/%m/%d') %>
                    (<%= %w[日 月 火 水 木 金 土][request.date.wday] %>)
                  </span>
                  <span class="px-2 py-1 rounded text-sm font-medium
                    <%= request.shift.am? || request.shift.full_day? ? 'bg-yellow-100 text-yellow-800' : 'bg-orange-100 text-orange-800' %>">
                    <%= request.shift_period_label %>
                  </span>
                </div>

                <div class="mb-4">
                  <div class="flex items-center gap-2 text-gray-700">
                    <span class="font-medium text-lg"><%= request.staff.name %></span>
                    <span class="px-2 py-0.5 rounded text-xs
                      <%= request.staff.pharmacist? ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                      <%= request.staff.role_label %>
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-2 text-gray-600 mb-3">
                  <span class="font-medium"><%= request.from_store.name %></span>
                  <span class="text-gray-400">→</span>
                  <span class="font-medium text-red-600"><%= request.requesting_store.name %></span>
                  <span class="text-sm text-gray-500">(要請元)</span>
                </div>

                <% if request.reason.present? %>
                  <div class="bg-gray-50 rounded p-3 text-sm text-gray-600 mb-3">
                    <span class="font-medium">要請理由:</span>
                    <%= request.reason %>
                  </div>
                <% end %>

                <div class="text-sm text-gray-500">
                  要請者: <%= request.requested_by.name %>
                  (<%= request.created_at.strftime('%Y/%m/%d %H:%M') %>)
                </div>
              </div>

              <div class="ml-4">
                <%= button_to approve_support_request_path(request),
                      method: :post,
                      class: 'px-6 py-2 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700 transition' do %>
                  承認
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= link_to 'AI提案を確認', suggestions_shifts_path, class: 'text-blue-600 hover:underline' %>
    </div>
  </div>
</div>

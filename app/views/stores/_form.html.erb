<%# app/views/stores/_form.html.erb %>

<%= form_with model: store, class: "space-y-6" do |f| %>
  <% if store.errors.any? %>
    <div class="p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
      <h3 class="font-bold mb-2"><%= pluralize(store.errors.count, "件のエラー") %>があります</h3>
      <ul class="list-disc list-inside text-sm">
        <% store.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 店舗基本情報 -->
  <div class="bg-white rounded-xl shadow p-6">
    <h2 class="text-lg font-bold mb-4">店舗情報</h2>

    <div class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">店舗コード <span class="text-red-500">*</span></label>
          <%= f.text_field :code, class: "block w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "001" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">店舗名 <span class="text-red-500">*</span></label>
          <%= f.text_field :name, class: "block w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "博多駅前店" %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">住所</label>
        <%= f.text_field :address, class: "block w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "福岡県福岡市博多区..." %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">最寄駅</label>
        <%= f.text_field :nearest_station, class: "block w-full px-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "博多駅" %>
      </div>
    </div>
  </div>

  <!-- 必要人数設定（エリアマネージャー以上のみ編集可） -->
  <% if current_staff.manager_or_above? %>
    <div class="bg-white rounded-xl shadow p-6">
      <h2 class="text-lg font-bold mb-4">必要人数設定（曜日別 × AM/PM）</h2>
      <p class="text-sm text-gray-600 mb-4">各曜日・時間帯ごとに必要な薬剤師・事務の人数を設定してください。</p>

      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-3 py-2 text-left text-xs font-bold text-gray-600 uppercase">曜日</th>
              <th class="px-3 py-2 text-center text-xs font-bold text-gray-600 uppercase">時間帯</th>
              <th class="px-3 py-2 text-center text-xs font-bold text-gray-600 uppercase">薬剤師</th>
              <th class="px-3 py-2 text-center text-xs font-bold text-gray-600 uppercase">事務</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <%
              # 月曜始まりで並べ替え（1,2,3,4,5,6,0）
              day_order = [1, 2, 3, 4, 5, 6, 0]
              sorted_requirements = store.store_requirements.sort_by do |r|
                [day_order.index(r.day_of_week) || 0, r.shift_period == 'am' ? 0 : 1]
              end
            %>
            <% day_order.each do |day| %>
              <%
                day_name = StoreRequirement::DAY_NAMES[day]
                day_class = case day
                            when 0 then 'text-red-500 font-bold'
                            when 6 then 'text-blue-500 font-bold'
                            else 'text-gray-700'
                            end
              %>
              <% [:am, :pm].each_with_index do |period, idx| %>
                <%
                  requirement = sorted_requirements.find { |r| r.day_of_week == day && r.shift_period == period.to_s }
                  next unless requirement
                  period_label = period == :am ? 'AM' : 'PM'
                  period_bg = period == :am ? 'bg-blue-50' : 'bg-orange-50'
                %>
                <%= f.fields_for :store_requirements, requirement do |req| %>
                  <tr class="<%= period_bg %>">
                    <% if idx == 0 %>
                      <td class="px-3 py-2 <%= day_class %>" rowspan="2">
                        <%= day_name %>曜日
                      </td>
                    <% end %>
                    <td class="px-3 py-2 text-center text-sm font-medium">
                      <%= period_label %>
                      <%= req.hidden_field :day_of_week %>
                      <%= req.hidden_field :shift_period %>
                    </td>
                    <td class="px-3 py-2 text-center">
                      <%= req.number_field :pharmacist_count, min: 0, class: "w-16 px-2 py-1 border rounded text-center text-sm focus:ring-2 focus:ring-blue-500", placeholder: "0" %>
                    </td>
                    <td class="px-3 py-2 text-center">
                      <%= req.number_field :clerk_count, min: 0, class: "w-16 px-2 py-1 border rounded text-center text-sm focus:ring-2 focus:ring-blue-500", placeholder: "0" %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-4 p-3 bg-gray-50 rounded-lg text-sm text-gray-600">
        <p>※ 0を設定すると、その時間帯は人員不要として扱われます</p>
      </div>
    </div>
  <% end %>

  <!-- 送信ボタン -->
  <div class="flex gap-4">
    <%= f.submit store.persisted? ? '更新する' : '登録する', class: "flex-1 py-3 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700 transition cursor-pointer" %>
    <%= link_to 'キャンセル', stores_path, class: "flex-1 py-3 bg-gray-200 text-gray-700 rounded-lg font-bold text-center hover:bg-gray-300 transition" %>
  </div>
<% end %>

<!DOCTYPE html>
<html>
  <head>
    <title>応援シフト管理システム</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="UTF-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice %>
      <div class="fixed top-4 right-4 z-50 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg shadow-lg">
        <%= notice %>
      </div>
    <% end %>

    <% if current_staff %>
      <nav class="bg-gray-800 text-white px-4 py-2 flex justify-between items-center text-sm">
        <div class="flex items-center gap-4">
          <span class="font-bold">シフト管理</span>
          <%= link_to 'シフト', shifts_path, class: 'hover:text-gray-300' %>
          <% if current_staff.store_manager_or_above? %>
            <%= link_to support_requests_path, class: 'hover:text-gray-300 relative inline-flex items-center' do %>
              承認待ち
              <% if pending_support_requests_count > 0 %>
                <span class="ml-1 bg-red-500 text-white text-xs rounded-full min-w-[1.25rem] h-5 flex items-center justify-center px-1">
                  <%= pending_support_requests_count %>
                </span>
              <% end %>
            <% end %>
          <% end %>
          <%= link_to '店舗', stores_path, class: 'hover:text-gray-300' %>
          <% if current_staff.admin? %>
            <%= link_to 'インポート', new_import_path, class: 'hover:text-gray-300' %>
            <%= link_to 'スタッフ', staffs_path, class: 'hover:text-gray-300' %>
          <% end %>
        </div>
        <div class="flex items-center gap-4">
          <span class="text-gray-300"><%= current_staff.name %>（<%= current_staff.permission_label %>）</span>
          <%= button_to 'ログアウト', logout_path, method: :delete, class: 'bg-red-600 hover:bg-red-700 px-3 py-1 rounded text-xs' %>
        </div>
      </nav>
    <% end %>

    <%= yield %>
  </body>
</html>

<%# app/views/shifts/monthly.html.erb %>

<div class="min-h-screen bg-gray-100">
  <!-- ヘッダー -->
  <header class="bg-gradient-to-r from-indigo-600 to-indigo-800 text-white py-4 px-6 shadow-lg">
    <h1 class="text-xl font-bold">📅 月間シフト</h1>
    <p class="text-sm opacity-90"><%= period_label(@period[:year], @period[:month]) %>（<%= @period[:start_date].strftime('%-m/%-d') %>〜<%= @period[:end_date].strftime('%-m/%-d') %>）</p>
  </header>

  <div class="max-w-full mx-auto px-4 py-6">
    <!-- ナビゲーション -->
    <div class="flex flex-wrap gap-2 mb-4">
      <%= link_to shifts_path, class: "px-4 py-2 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50" do %>
        日別ビュー
      <% end %>
      <%= link_to weekly_shifts_path, class: "px-4 py-2 bg-white text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50" do %>
        週間一覧
      <% end %>
      <%= link_to monthly_shifts_path(period: "#{@period[:year]}-#{format('%02d', @period[:month])}"), class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium" do %>
        月間一覧
      <% end %>
      <%= link_to suggestions_shifts_path, class: "px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-medium" do %>
        🤖 AI提案
      <% end %>
      <%= link_to new_import_path, class: "px-4 py-2 bg-gray-600 text-white rounded-lg text-sm font-medium" do %>
        📥 CSVインポート
      <% end %>
    </div>

    <!-- 月ナビゲーション -->
    <% prev_period = previous_period(@period[:year], @period[:month]) %>
    <% next_period_data = next_period(@period[:year], @period[:month]) %>
    <div class="bg-white rounded-xl p-4 shadow mb-6 flex items-center justify-between">
      <%= link_to monthly_shifts_path(period: "#{prev_period[:year]}-#{format('%02d', prev_period[:month])}"), class: "px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300" do %>
        ◀ 前月
      <% end %>
      <div class="text-lg font-bold">
        <%= period_label(@period[:year], @period[:month]) %>
      </div>
      <%= link_to monthly_shifts_path(period: "#{next_period_data[:year]}-#{format('%02d', next_period_data[:month])}"), class: "px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300" do %>
        翌月 ▶
      <% end %>
    </div>

    <!-- 凡例 -->
    <div class="bg-white rounded-xl p-4 shadow mb-6">
      <div class="flex flex-wrap items-center gap-6 text-sm">
        <span class="font-bold text-gray-700">凡例:</span>
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-red-500"></span>
          <span>不足</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-green-500"></span>
          <span>余剰</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-gray-300"></span>
          <span>充足</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 rounded bg-gray-400 opacity-50"></span>
          <span>休業</span>
        </div>
        <span class="text-gray-400">|</span>
        <span class="text-gray-600">各セル: 上=AM / 下=PM</span>
      </div>
    </div>

    <!-- カレンダーテーブル -->
    <div class="bg-white rounded-xl shadow overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="sticky left-0 bg-gray-50 z-10 px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wider border-r">
                店舗
              </th>
              <% (@period[:start_date]..@period[:end_date]).each do |date| %>
                <%
                  day_class = case date.wday
                              when 0 then 'text-red-500'  # 日曜
                              when 6 then 'text-blue-500' # 土曜
                              else 'text-gray-700'
                              end
                  is_holiday = defined?(HolidayJp) && HolidayJp.holiday?(date)
                  day_class = 'text-red-500' if is_holiday
                %>
                <th class="px-2 py-3 text-center text-xs font-medium <%= day_class %> border-b">
                  <div><%= date.strftime('%-d') %></div>
                  <div class="text-xs"><%= %w[日 月 火 水 木 金 土][date.wday] %></div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @stores.each_with_index do |store, idx| %>
              <% row_bg = idx.even? ? 'bg-white' : 'bg-gray-50' %>
              <tr class="<%= row_bg %>">
                <td class="sticky left-0 <%= row_bg %> z-10 px-4 py-3 text-sm font-medium text-gray-900 whitespace-nowrap border-r">
                  <%= store.name %>
                </td>
                <% @monthly_data.each do |day_data| %>
                  <% store_data = day_data[:stores].find { |s| s[:id] == store.id } %>
                  <%
                    am_status = store_data ? store_data[:am][:status] : :ok
                    pm_status = store_data ? store_data[:pm][:status] : :ok
                  %>
                  <td class="px-1 py-1 text-center">
                    <div class="flex flex-col gap-0.5">
                      <%# AM部分 %>
                      <%= link_to shifts_path(date: day_data[:date]),
                          class: "block w-6 h-3 mx-auto rounded-t #{status_cell_class(am_status)} hover:ring-2 hover:ring-offset-1 hover:ring-indigo-400",
                          title: "AM: #{am_tooltip(store_data)}" do %>
                      <% end %>
                      <%# PM部分 %>
                      <%= link_to shifts_path(date: day_data[:date]),
                          class: "block w-6 h-3 mx-auto rounded-b #{status_cell_class(pm_status)} hover:ring-2 hover:ring-offset-1 hover:ring-indigo-400",
                          title: "PM: #{pm_tooltip(store_data)}" do %>
                      <% end %>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- サマリー（月間集計） -->
    <div class="mt-6 bg-white rounded-xl p-4 shadow">
      <h2 class="text-lg font-bold text-gray-700 mb-4">📊 月間サマリー</h2>

      <!-- AM/PM別サマリー -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- AM サマリー -->
        <div class="p-4 bg-blue-50 rounded-lg">
          <h3 class="font-bold text-blue-700 mb-3">🌅 AM（午前）</h3>
          <div class="grid grid-cols-2 gap-3">
            <%
              am_shortage_days = @monthly_data.sum { |d| d[:summary][:am][:shortage_stores] }
              am_surplus_days = @monthly_data.sum { |d| d[:summary][:am][:surplus_stores] }
              am_ph_shortage = @monthly_data.sum { |d| d[:summary][:am][:total_pharmacist_shortage] }
              am_cl_shortage = @monthly_data.sum { |d| d[:summary][:am][:total_clerk_shortage] }
            %>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">不足発生</div>
              <div class="text-xl font-bold text-red-500"><%= am_shortage_days %><span class="text-sm">件</span></div>
            </div>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">余剰発生</div>
              <div class="text-xl font-bold text-green-500"><%= am_surplus_days %><span class="text-sm">件</span></div>
            </div>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">薬剤師不足</div>
              <div class="text-xl font-bold text-yellow-600"><%= am_ph_shortage %><span class="text-sm">名</span></div>
            </div>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">事務不足</div>
              <div class="text-xl font-bold text-blue-500"><%= am_cl_shortage %><span class="text-sm">名</span></div>
            </div>
          </div>
        </div>

        <!-- PM サマリー -->
        <div class="p-4 bg-orange-50 rounded-lg">
          <h3 class="font-bold text-orange-700 mb-3">🌆 PM（午後）</h3>
          <div class="grid grid-cols-2 gap-3">
            <%
              pm_shortage_days = @monthly_data.sum { |d| d[:summary][:pm][:shortage_stores] }
              pm_surplus_days = @monthly_data.sum { |d| d[:summary][:pm][:surplus_stores] }
              pm_ph_shortage = @monthly_data.sum { |d| d[:summary][:pm][:total_pharmacist_shortage] }
              pm_cl_shortage = @monthly_data.sum { |d| d[:summary][:pm][:total_clerk_shortage] }
            %>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">不足発生</div>
              <div class="text-xl font-bold text-red-500"><%= pm_shortage_days %><span class="text-sm">件</span></div>
            </div>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">余剰発生</div>
              <div class="text-xl font-bold text-green-500"><%= pm_surplus_days %><span class="text-sm">件</span></div>
            </div>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">薬剤師不足</div>
              <div class="text-xl font-bold text-yellow-600"><%= pm_ph_shortage %><span class="text-sm">名</span></div>
            </div>
            <div class="p-2 bg-white rounded">
              <div class="text-xs text-gray-500">事務不足</div>
              <div class="text-xl font-bold text-blue-500"><%= pm_cl_shortage %><span class="text-sm">名</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
